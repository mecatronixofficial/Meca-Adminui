# API base URL including the /mec-api prefix. Leave unset to use /mec-api,
# which Vite proxies to VITE_API_PROXY_TARGET (default http://localhost:5000) in development.
VITE_API_BASE_URL=/mec-api

# Optional: where the dev/preview proxy forwards /mec-api requests.
# VITE_API_PROXY_TARGET=http://localhost:5000

# Public Next.js website used by the work library and website preview links.
VITE_API_CUSTOMER_BASE_URL=http://localhost:3000

# Optional: this admin app's public URL (no trailing slash). Used for the canonical
# link and absolute link-preview image URLs, e.g. https://admin.mecatronix.one
# VITE_ADMIN_URL=
