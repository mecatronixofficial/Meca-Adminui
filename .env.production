# ─── Mecatronix Admin UI · production build ─────────────────────────────────
# Loaded by `bun run build` / `npm run build` (overrides .env).
# Every VITE_ value is compiled into the browser bundle: never put secrets here.
# For machine-specific overrides, create .env.production.local (not committed).

# API base. Keep /mec-api when the host forwards /mec-api to the backend;
# otherwise use the full API URL, e.g. https://api.mecatronix.one/mec-api
VITE_API_BASE_URL=/mec-api

# Public website.
VITE_API_CUSTOMER_BASE_URL=https://www.mecatronix.one

# This admin app's public URL (no trailing slash): canonical link and link-preview images.
# Set it once the admin domain is final, e.g. https://admin.mecatronix.one
VITE_ADMIN_URL=
