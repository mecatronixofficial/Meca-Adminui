# ─── Mecatronix Admin UI · production build ─────────────────────────────────
# Loaded by `bun run build` / `npm run build` (overrides .env).
# Every VITE_ value is compiled into the browser bundle: never put secrets here.
# Variables set in the Vercel dashboard override this file: remove any old VITE_API_BASE_URL there.

# API base. vercel.json forwards /mec-api to https://mecaserver.vercel.app/mec-api, so the
# login cookie (SameSite=strict) is first-party and the session survives after sign-in.
# Don't point this straight at https://mecaserver.vercel.app: the browser would drop the cookie.
VITE_API_BASE_URL=/mec-api

# Public website.
VITE_API_CUSTOMER_BASE_URL=https://www.mecatronix.one

# This admin app's public URL (no trailing slash): canonical link and link-preview images.
VITE_ADMIN_URL=https://admin.mecatronix.one
